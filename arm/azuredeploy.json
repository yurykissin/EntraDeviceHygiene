{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Entra Device Hygiene - deploys a scheduled Logic App (system-assigned managed identity) that queries Microsoft Graph for stale devices and adds them to a review group. The review group must already exist (or be created via the companion bootstrap script) and its objectId is passed in. Graph application permissions (Device.Read.All, GroupMember.ReadWrite.All) must be granted to the Logic App's managed identity out of band."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-entra-device-hygiene",
      "metadata": { "description": "Name of the Logic App workflow." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region." }
    },
    "staleThresholdDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 30,
      "maxValue": 730,
      "metadata": { "description": "Devices whose approximateLastSignInDateTime is older than this many days are considered stale." }
    },
    "scheduleFrequency": {
      "type": "string",
      "defaultValue": "Day",
      "allowedValues": [ "Hour", "Day", "Week", "Month" ],
      "metadata": { "description": "Recurrence frequency for the Logic App." }
    },
    "scheduleInterval": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": { "description": "Recurrence interval (combined with scheduleFrequency)." }
    },
    "reviewGroupObjectId": {
      "type": "string",
      "metadata": { "description": "Object ID of the Entra security group that will hold stale devices for review. Group must be security-enabled and assignable. Create it ahead of time (see scripts/Bootstrap-ReviewGroup.ps1)." }
    },
    "excludeAutopilot": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "When true, devices with physicalIds containing a ZTDID (Autopilot) are skipped." }
    },
    "excludeHybridJoined": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "When true, devices with trustType 'ServerAd' (hybrid Entra-joined) are skipped." }
    },
    "dryRun": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "When true, the workflow only logs candidates and does not modify group membership." }
    }
  },
  "variables": {
    "graphBaseUri": "https://graph.microsoft.com/v1.0"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "staleThresholdDays": { "type": "Int" },
            "graphBaseUri":       { "type": "String" },
            "reviewGroupObjectId":{ "type": "String" },
            "excludeAutopilot":   { "type": "Bool" },
            "excludeHybridJoined":{ "type": "Bool" },
            "dryRun":             { "type": "Bool" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "[parameters('scheduleFrequency')]",
                "interval":  "[parameters('scheduleInterval')]"
              }
            }
          },
          "actions": {
            "Compute_Cutoff": {
              "type": "Compose",
              "inputs": "@{addDays(utcNow(), mul(-1, parameters('staleThresholdDays')))}"
            },
            "List_Stale_Devices": {
              "runAfter": { "Compute_Cutoff": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat(parameters('graphBaseUri'), '/devices')}",
                "queries": {
                  "$select": "id,displayName,deviceId,approximateLastSignInDateTime,accountEnabled,trustType,physicalIds,operatingSystem",
                  "$filter": "@{concat('approximateLastSignInDateTime le ', outputs(''Compute_Cutoff''))}",
                  "$top": "999"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Initialize_Candidates": {
              "runAfter": { "List_Stale_Devices": [ "Succeeded" ] },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "candidates", "type": "Array", "value": [] }
                ]
              }
            },
            "Filter_Devices": {
              "runAfter": { "Initialize_Candidates": [ "Succeeded" ] },
              "type": "Foreach",
              "foreach": "@body('List_Stale_Devices')?['value']",
              "actions": {
                "Evaluate_Device": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "or": [
                          { "equals": [ "@parameters('excludeHybridJoined')", false ] },
                          { "not": { "equals": [ "@coalesce(items('Filter_Devices')?['trustType'],'')", "ServerAd" ] } }
                        ]
                      },
                      {
                        "or": [
                          { "equals": [ "@parameters('excludeAutopilot')", false ] },
                          { "equals": [ "@length(filter(coalesce(items('Filter_Devices')?['physicalIds'], createArray()), or(startsWith(item(),'[ZTDID]'), startsWith(item(),'[ZTDId]'))))", 0 ] }
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Append_Candidate": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "candidates",
                        "value": "@items('Filter_Devices')"
                      }
                    }
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": { "repetitions": 20 }
              }
            },
            "Add_To_Review_Group": {
              "runAfter": { "Filter_Devices": [ "Succeeded" ] },
              "type": "If",
              "expression": {
                "and": [
                  { "equals": [ "@parameters('dryRun')", false ] },
                  { "greater": [ "@length(variables('candidates'))", 0 ] }
                ]
              },
              "actions": {
                "Add_Members": {
                  "type": "Foreach",
                  "foreach": "@variables('candidates')",
                  "actions": {
                    "POST_addRef": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "@{concat(parameters('graphBaseUri'), '/groups/', parameters('reviewGroupObjectId'), '/members/$ref')}",
                        "headers": { "Content-Type": "application/json" },
                        "body": {
                          "@@odata.id": "@{concat(parameters('graphBaseUri'), '/directoryObjects/', items('Add_Members')?['id'])}"
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://graph.microsoft.com"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "runtimeConfiguration": {
                    "concurrency": { "repetitions": 5 }
                  }
                }
              }
            },
            "Response_Summary": {
              "runAfter": { "Add_To_Review_Group": [ "Succeeded", "Skipped" ] },
              "type": "Compose",
              "inputs": {
                "cutoff": "@outputs('Compute_Cutoff')",
                "candidateCount": "@length(variables('candidates'))",
                "dryRun": "@parameters('dryRun')",
                "reviewGroupObjectId": "@parameters('reviewGroupObjectId')",
                "candidates": "@variables('candidates')"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "staleThresholdDays":  { "value": "[parameters('staleThresholdDays')]" },
          "graphBaseUri":        { "value": "[variables('graphBaseUri')]" },
          "reviewGroupObjectId": { "value": "[parameters('reviewGroupObjectId')]" },
          "excludeAutopilot":    { "value": "[parameters('excludeAutopilot')]" },
          "excludeHybridJoined": { "value": "[parameters('excludeHybridJoined')]" },
          "dryRun":              { "value": "[parameters('dryRun')]" }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    },
    "nextSteps": {
      "type": "string",
      "value": "Grant Graph application permissions Device.Read.All and GroupMember.ReadWrite.All to the managed identity (see scripts/Grant-GraphPermissions.ps1)."
    }
  }
}
